# =====================================================================
# Auto-Editor Configuration
# =====================================================================

# Cloud ASR Service API Key
# Supports any ASR provider compatible with the submit/query API pattern.
# Default endpoint: ByteDance Volcano Engine Speech Recognition
# Get your key at: https://console.volcengine.com/speech/new/experience/asr
ASR_API_KEY=your_api_key_here

# Optional: Custom output directory
# OUTPUT_DIR=./output

# Optional: Silence threshold in seconds (default: 0.3)
# SILENCE_THRESHOLD=0.3

# Optional: Repeat detection word count (default: 5)
# REPEAT_WORD_COUNT=5

# Optional: Override ASR endpoint URLs
# ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v1/vc/submit
# ASR_QUERY_URL=https://openspeech.bytedance.com/api/v1/vc/query